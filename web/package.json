{
    "name": "ruffle",
    "version": "0.2.0",
    "description": "Root project of ruffle web",
    "license": "(MIT OR Apache-2.0)",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "config": {
        "detect_chromedriver_version": true
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@wdio/browserstack-service": "^9.27.2",
        "@wdio/cli": "^9.27.2",
        "@wdio/local-runner": "^9.27.2",
        "@wdio/mocha-framework": "^9.27.2",
        "@wdio/spec-reporter": "^9.27.2",
        "@wdio/static-server-service": "^9.27.2",
        "chai": "^6.2.2",
        "chai-html": "^3.2.0",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.0.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "mocha": "^11.7.6",
        "prettier": "^3.8.3",
        "stylelint": "^17.12.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-prettier": "^5.0.3",
        "ts-loader": "^9.6.0",
        "tsx": "^4.22.4",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.60.1",
        "webdriverio": "^9.27.2",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.3",
        "workspace-version": "^0.1.4"
    },
    "scripts": {
        "dev": "pnpm --filter ruffle-demo dev",
        "build": "pnpm --filter ruffle-core build && pnpm --filter ruffle-demo build && pnpm --filter ruffle-extension build && pnpm --filter ruffle-selfhosted build",
        "build:debug": "cross-env NODE_ENV=development CARGO_FEATURES=avm_debug pnpm run build",
        "build:dual-wasm": "cross-env BUILD_WASM_MVP=true pnpm run build",
        "build:repro": "cross-env ENABLE_VERSION_SEAL=true pnpm run build",
        "build:dual-wasm-repro": "cross-env BUILD_WASM_MVP=true ENABLE_VERSION_SEAL=true pnpm run build",
        "demo": "pnpm --filter ruffle-demo run preview",
        "test": "pnpm -r run --if-present test",
        "wdio": "pnpm -r run --if-present wdio --",
        "docs": "pnpm -r run --if-present docs",
        "lint": "pnpm -r run --if-present checkTypes && eslint . && stylelint **.css",
        "format": "eslint . --fix && stylelint --fix **.css",
        "version-seal": "cross-env ENABLE_VERSION_SEAL=true tsx packages/core/tools/set_version.ts"
    }
}
