{
    "compilerOptions": {
        "strict": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "noPropertyAccessFromIndexSignature": true,
        "composite": true,
        "module": "es2020",
        "moduleResolution": "node",
        "target": "es2021",
        "rootDir": ".",
        "outDir": "dist",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": ["test/**/*", "wdio.conf.ts", "wdio-env.d.ts"]
}
